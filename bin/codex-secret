#!/usr/bin/python3
"""Minimal Codex credential access through freedesktop Secret Service."""

import argparse
import json
import os
import secrets
import subprocess
import sys
import uuid
from pathlib import Path
from urllib.parse import urlsplit

import gi

gi.require_version("Secret", "1")
from gi.repository import GLib, Secret  # noqa: E402

FIELDS = ("name", "service", "website", "domain", "username", "type", "project", "host", "notes")
SCHEMA = Secret.Schema.new("com.openai.Codex.Credential", Secret.SchemaFlags.NONE,
    {key: Secret.SchemaAttributeType.STRING for key in ("codex", "id", *FIELDS)})


def fail(message):
    raise SystemExit(f"codex-secret: {message}")


def clean(value):
    return value.strip() if value else ""


def hostname(value):
    value = clean(value).lower().rstrip(".")
    parsed = urlsplit(value if "://" in value else f"//{value}")
    return (parsed.hostname or "").rstrip(".")


def domain_matches(target, saved):
    target, saved = hostname(target), hostname(saved)
    return bool(target and saved and (target == saved or target.endswith(f".{saved}")))


def validate_website(value):
    if not value:
        return ""
    parsed = urlsplit(value)
    if not parsed.scheme or not parsed.hostname:
        fail("website must be an absolute URL")
    if parsed.scheme != "https" and parsed.hostname not in {"localhost", "127.0.0.1", "::1"}:
        fail("non-local website must use HTTPS")
    return value.rstrip("/")


def item_meta(item):
    values = item.get_attributes()
    return {"store": "secret-service", "id": values.get("id", ""),
            **{key: values.get(key, "") for key in FIELDS}}


def items():
    flags = Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK
    return Secret.password_search_sync(SCHEMA, {"codex": "credential"}, flags, None)


def selectors(args):
    keys = ("service", "website", "domain", "username", "project", "host")
    return {key: clean(getattr(args, key, "")) for key in keys if clean(getattr(args, key, ""))}


def score(meta, wanted):
    total = 0
    for key, value in wanted.items():
        saved = meta.get(key, "")
        if key == "website":
            target = hostname(validate_website(value))
            saved_domain = meta.get("domain") or hostname(saved) or meta.get("host")
            if clean(saved).casefold() == clean(value).rstrip("/").casefold():
                total += 8
            elif domain_matches(target, saved_domain):
                total += 6
            else:
                return -1
        elif key == "domain":
            if not domain_matches(value, saved):
                return -1
            total += 5
        elif key == "host":
            if hostname(value) != hostname(saved):
                return -1
            total += 5
        elif clean(saved).casefold() != value.casefold():
            return -1
        else:
            total += 4
    return total


def matches(args):
    wanted, found = selectors(args), []
    for item in items():
        meta = item_meta(item)
        if getattr(args, "id", "") and meta["id"] != args.id:
            continue
        rank = score(meta, wanted)
        if rank >= 0:
            found.append((rank, meta, item))
    return sorted(found, key=lambda row: (-row[0], row[1]["service"], row[1]["username"], row[1]["id"]))


def select(args, verify_web=False):
    if not getattr(args, "id", "") and not selectors(args):
        fail("an id or lookup field is required")
    found = matches(args)
    if not found:
        fail("no matching credential")
    if len(found) > 1 and found[0][0] == found[1][0]:
        fail("multiple credentials tie for best match")
    meta, item = found[0][1], found[0][2]
    kind = meta["type"].casefold()
    if verify_web and kind in {"web", "login", "api"} and not (getattr(args, "website", "") or getattr(args, "domain", "")):
        fail("web credential use requires website or domain verification")
    if verify_web and kind == "ssh" and not getattr(args, "host", ""):
        fail("SSH credential use requires host verification")
    return meta, item


def secret(item):
    item.load_secret_sync(None)
    value = item.get_secret()
    if value is None:
        fail("credential has no secret value")
    return value.get_text()


def attributes(meta):
    return {"codex": "credential", "id": meta["id"],
            **{key: meta[key] for key in FIELDS if meta.get(key)}}


def metadata_from(args, current=None):
    meta = dict(current or {})
    for key in FIELDS:
        value = getattr(args, key, None)
        if value is not None:
            meta[key] = clean(value)
    meta.setdefault("id", str(uuid.uuid4()))
    meta.setdefault("store", "secret-service")
    if meta.get("website"):
        meta["website"] = validate_website(meta["website"])
        website_domain = hostname(meta["website"])
        if meta.get("domain") and not domain_matches(website_domain, meta["domain"]):
            fail("saved domain does not match website")
        meta["domain"] = meta.get("domain") or website_domain
    if not all(meta.get(key) for key in ("name", "service", "type")):
        fail("name, service, and type are required")
    return meta


def read_stdin_secret():
    if sys.stdin.isatty():
        fail("secret value must be supplied on stdin")
    value = sys.stdin.read()
    if not value:
        fail("secret value is empty")
    return value


def store(meta, value):
    Secret.password_store_sync(SCHEMA, attributes(meta), Secret.COLLECTION_DEFAULT, meta["name"], value, None)


def cmd_list(_args):
    print(json.dumps([item_meta(item) for item in items()], sort_keys=True))


def cmd_search(args):
    print(json.dumps([row[1] for row in matches(args)], sort_keys=True))


def cmd_lookup(args):
    print(json.dumps(select(args)[0], sort_keys=True))


def cmd_create(args):
    meta = metadata_from(args)
    store(meta, read_stdin_secret())
    query = argparse.Namespace(id=meta["id"], service="", website="", domain="", username="", project="", host="")
    if not matches(query):
        fail("credential storage verification failed")
    print(meta["id"])


def cmd_update(args):
    old, item = select(args)
    new = metadata_from(args, old)
    value = read_stdin_secret() if args.secret_stdin else secret(item)
    old_attrs, new_attrs = attributes(old), attributes(new)
    store(new, value)
    if new_attrs != old_attrs:
        Secret.password_clear_sync(SCHEMA, old_attrs, None)
    print(new["id"])


def cmd_get(args):
    if args.fd < 3:
        fail("get requires a private file descriptor (3 or higher)")
    os.write(args.fd, secret(select(args, verify_web=True)[1]).encode())


def cmd_exec(args):
    if not args.command:
        fail("exec requires a command")
    value = secret(select(args, verify_web=True)[1])
    if args.env:
        env = os.environ.copy()
        env[args.env] = value
        result = subprocess.run(args.command, env=env, check=False)
    else:
        result = subprocess.run(args.command, input=value.encode(), check=False)
    raise SystemExit(result.returncode)


def cmd_delete(args):
    if not select(args)[1].delete_sync(None):
        fail("credential deletion failed")


def cmd_test(_args):
    marker, token = f"codex-test-{uuid.uuid4()}", secrets.token_urlsafe(32)
    meta = {"store": "secret-service", "id": marker, "name": "Codex Secret Service self-test",
            "service": marker, "website": "https://example.invalid", "domain": "example.invalid",
            "username": "self-test", "type": "web", "project": "codex", "host": "",
            "notes": "temporary self-test"}
    checks = []
    try:
        store(meta, token)
        checks.append("create")
        query = argparse.Namespace(id="", service=marker, website="https://example.invalid/login", domain="", username="", project="", host="")
        selected, item = select(query)
        assert selected["id"] == marker
        checks += ["lookup", "domain-match"]
        assert secret(item) == token
        checks.append("read")
        try:
            bad = argparse.Namespace(id="", service=marker, website="https://wrong.example/login", domain="", username="", project="", host="")
            select(bad)
            raise AssertionError("wrong domain accepted")
        except SystemExit:
            checks.append("wrong-domain-rejected")
        token = secrets.token_urlsafe(32)
        store(meta, token)
        assert secret(select(query)[1]) == token
        checks.append("update")
        for root in (Path("/home/galgo/.codex"), Path("/home/galgo/Obsidian/Codex-System")):
            for path in root.rglob("*"):
                if path.is_file() and token.encode() in path.read_bytes():
                    raise AssertionError(f"secret found in normal file: {path}")
        checks.append("normal-files-clean")
        journal = subprocess.run(["journalctl", "--user", "--since", "-2 minutes", "--no-pager", "-o", "cat"], capture_output=True, check=False)
        assert token.encode() not in journal.stdout + journal.stderr
        checks.append("logs-clean")
        types = {item_meta(entry)["type"].casefold() for entry in items() if item_meta(entry)["id"] != marker}
        checks.append("ssh-lookup" if "ssh" in types else "ssh-none")
        checks.append("web-lookup" if types & {"web", "login"} else "web-none")
    finally:
        Secret.password_clear_sync(SCHEMA, {"codex": "credential", "id": marker}, None)
    print(json.dumps({"backend": "freedesktop-secret-service", "checks": checks, "result": "ok"}))


def add_lookup(parser, include_id=True):
    if include_id:
        parser.add_argument("--id", default="")
    for key in ("service", "website", "domain", "username", "project", "host"):
        parser.add_argument(f"--{key}", default="")


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="operation", required=True)
    listing = sub.add_parser("list", help="list metadata only")
    listing.set_defaults(func=cmd_list)
    search = sub.add_parser("search", help="search metadata")
    add_lookup(search, False)
    search.set_defaults(func=cmd_search)
    lookup = sub.add_parser("lookup", help="select best matching metadata")
    add_lookup(lookup)
    lookup.set_defaults(func=cmd_lookup)
    create = sub.add_parser("create", help="create from secret on stdin")
    for key in FIELDS:
        create.add_argument(f"--{key}", required=key in {"name", "service", "type"})
    create.set_defaults(func=cmd_create)
    update = sub.add_parser("update", help="update metadata and optionally secret from stdin")
    update.add_argument("--id", required=True)
    for key in FIELDS:
        update.add_argument(f"--{key}")
    update.add_argument("--secret-stdin", action="store_true")
    update.set_defaults(func=cmd_update)
    get = sub.add_parser("get", help="write secret to a private file descriptor")
    add_lookup(get)
    get.add_argument("--fd", type=int, required=True)
    get.set_defaults(func=cmd_get)
    execute = sub.add_parser("exec", help="inject secret into one command")
    add_lookup(execute)
    execute.add_argument("--env", metavar="NAME")
    execute.add_argument("command", nargs=argparse.REMAINDER)
    execute.set_defaults(func=cmd_exec)
    delete = sub.add_parser("delete", help="delete only on explicit request")
    delete.add_argument("--id", required=True)
    add_lookup(delete, False)
    delete.set_defaults(func=cmd_delete)
    test = sub.add_parser("test", help="run non-disclosing integration checks")
    test.set_defaults(func=cmd_test)
    args = parser.parse_args()
    try:
        args.func(args)
    except (OSError, UnicodeError, GLib.Error) as error:
        fail(f"Secret Service operation failed ({type(error).__name__})")


if __name__ == "__main__":
    main()
